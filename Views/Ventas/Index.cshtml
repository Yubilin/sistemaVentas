@using sistemaVentas.Models
@model List<Venta>
@{
    ViewData["Title"] = "Ventas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ventas</h2>
    <a class="btn btn-success" asp-action="Create">Nueva Venta</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Total</th>
            <th>Recibido</th>
            <th>Cambio</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.Id</td>
                <td>@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(v.Cliente != null ? $"{v.Cliente.Nombre} {v.Cliente.Apellido}".Trim() : "Cliente General")</td>
                <td>@v.Total.ToString("C2")</td>
                <td>@v.Recibido.ToString("C2")</td>
                <td>@v.Cambio.ToString("C2")</td>
                <td>
                    <a class="btn btn-sm btn-info text-white" asp-action="Details" asp-route-id="@v.Id">Detalles</a>
                </td>
            </tr>
        }
    </tbody>
</table>