@using sistemaVentas.Models
@model List<Producto>
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Productos</h2>
    <a class="btn btn-success" asp-action="Create">Nuevo Producto</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Categoría</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var p in Model)
            {
                var stockActual = p.Stock ?? 0;
                var stockMin = p.StockMinimo ?? 0;

                <tr>
                    <td>@p.Id</td>
                    <td>@(p.Nombre ?? "Sin Nombre")</td>
                    <td>@string.Format("{0:C2}", p.Precio ?? 0)</td>
                    <td>
                        @if (stockActual <= stockMin)
                        {
                            <span class="badge bg-danger">@stockActual (Bajo)</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@stockActual</span>
                        }
                    </td>
                    <td>@(p.Categoria?.Nombre ?? "Sin Categoría")</td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@p.Id">Editar</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@p.Id">Eliminar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No hay productos registrados.</td>
            </tr>
        }
    </tbody>
</table>